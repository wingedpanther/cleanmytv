<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The music visualiser reads the TV's mixed output. CleanMyTV grants this over ADB. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Weather next to the clock, from Open-Meteo or MET Norway, and the pictures in Continue watching,
         from the servers of the app that put them there. Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Quick settings panel's network row: Wi-Fi or Ethernet, and the TV's address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Quick settings panel: screensaver, sleep, Private DNS, animations, clock. CleanMyTV grants
         these over ADB when it installs Home; without them the panel opens the TV's own screens. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Puts the remote-button service back after a restart when the TV has dropped it (#78). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bedtime turns the TV off on the minute: Android 12 grants the first, 13 and later the second. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Clean memory: closes apps left in the background, up to Android 13. Apps with a launcher icon are
         the ones the queries below already let Home see. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Uninstall in a tile's long-press menu: Android still asks the owner to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Home updates itself from the release page; Android still asks the owner to confirm each one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Back to the input at power on (#94): Android 10 and later only let an app open another app's screen
         from the background when it may draw over other apps. CleanMyTV allows it over ADB; Home draws no
         overlay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Recently used: the desktop app grants usage access over ADB only while that row is on. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Continue watching: the TV provider's Watch Next list. The first lets Home open the provider at all;
         the second, which CleanMyTV grants over ADB, lets it see other apps' entries and not only its own. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Android 11+ hides other apps unless we say which ones we look for. -->
    <queries>
        <!-- The keyboards, so Home can put the owner's back when the TV switches at a restart (#98). -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The launcher that keeps taking Home, and its home screen (KeyService's redirect). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The TV provider, for Continue watching. -->
        <provider android:authorities="android.media.tv" />
        <!-- The app that shows the TV's inputs, for going back to one at power on. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <!-- XGIMI's HDMI switcher, for a projector that opens no port's picture from its link (#127). -->
        <intent>
            <action android:name="com.xgimi.action.hdmiPlayer" />
        </intent>
    </queries>

    <application
        android:label="CleanMyTV Home"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The app lock's PIN pad, over a locked app however it was opened. Its own task, so Back
             and recents never land on it by mistake. No orientation of its own: Android 8.0 won't start a
             see-through screen that sets one, and it takes the landscape of the screen under it. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- The sleep timer's alarm. -->
        <!-- Input tiles open through this: it switches to the input and closes without showing anything. -->
        <activity
            android:name=".InputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver android:name=".SleepReceiver" android:exported="false" />
        <receiver android:name=".BedtimeReceiver" android:exported="false" />
        <!-- Android's installer reports on an update here. -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- The on-TV editor (experimental), opened from its top bar icon. See-through, so no orientation,
             as the PIN pad. -->
        <activity
            android:name=".customization.CustomizationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- Screen time's dashboard, opened from its section, top bar icon or a remote button. -->
        <activity
            android:name=".ScreenTimeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape" />

        <!-- The fireplace, full screen on demand, and as a screensaver the TV lists by name. -->
        <activity
            android:name=".FireplaceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape" />
        <service
            android:name=".SlidesDream"
            android:exported="true"
            android:label="@string/slides_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name=".FireplaceDream"
            android:exported="true"
            android:label="@string/fireplace_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Remote buttons mapped in CleanMyTV, and the app lock's guard. Off until the desktop app turns it on over ADB. -->
        <service
            android:name=".KeyService"
            android:exported="false"
            android:label="@string/key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/key_service" />
        </service>

        <!-- Lets Home see what other apps are playing, for the Now playing section. It reads no
             notifications. CleanMyTV switches it on over ADB only when that section is on. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="false"
            android:label="@string/now_playing_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Settings come in through ADB (`content call`), never a shared folder. Only the shell
             user may call it; ConfigProvider checks the caller. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.wingedpanther.cleanmytv.home.config"
            android:exported="true" />
    </application>
</manifest>
